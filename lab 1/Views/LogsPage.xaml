<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="lab_1.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Logs">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="Refresh" Clicked="OnRefreshClicked" />
            <Button Text="Clear" Clicked="OnClearClicked" />
            <Label
                x:Name="StatusLabel"
                VerticalOptions="Center"
                FontSize="12"
                Opacity="0.8" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1" Orientation="Horizontal">
            <HorizontalStackLayout x:Name="FilterBar" Spacing="6">
                <Button Text="ALL" Clicked="OnFilterClicked" />
                <Button Text="DBG" Clicked="OnFilterClicked" />
                <Button Text="INF" Clicked="OnFilterClicked" />
                <Button Text="WRN" Clicked="OnFilterClicked" />
                <Button Text="ERR" Clicked="OnFilterClicked" />
                <Button Text="FTL" Clicked="OnFilterClicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" Padding="8">
            <ScrollView>
                <Editor
                    x:Name="LogsEditor"
                    IsReadOnly="True"
                    AutoSize="TextChanges"
                    FontFamily="Consolas"
                    FontSize="12" />
            </ScrollView>
        </Border>
    </Grid>

</ContentPage>