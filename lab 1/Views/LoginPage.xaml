<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lab_1.Views.LoginPage"
             Title="Вхід у систему">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="Автентифікація"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Entry Placeholder="Логін (наприклад, admin або dispatcher)"
               Text="{Binding Login}" />

        <Entry Placeholder="Пароль"
               IsPassword="True"
               Text="{Binding Password}" />

        <Button Text="Увійти"
                Command="{Binding LoginCommand}" />

        <Button Text="Увійти через біометрію"
                Command="{Binding BiometricLoginCommand}" />

        <Label Text="{Binding StatusMessage}"
               TextColor="Gray"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
    