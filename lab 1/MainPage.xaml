<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:lab_1.ViewModels"
             x:Class="lab_1.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Панель користувача та ролі (Лаб 6) -->
            <HorizontalStackLayout Spacing="10">
                <Label Text="{Binding CurrentUserInfo}"
                       VerticalOptions="Center"
                       FontAttributes="Bold" />
                <Button Text="Вийти"
                        Command="{Binding LogoutCommand}" />
                <Button Text="Керування користувачами"
                        Command="{Binding ManageUsersCommand}"
                        IsVisible="{Binding IsAdminPanelVisible}" />
            </HorizontalStackLayout>

            <!-- Поля вводу (TwoWay) -->
            <Entry Text="{Binding FullName, Mode=TwoWay}" Placeholder="ПІБ студента" />
            <Entry Text="{Binding Group, Mode=TwoWay}" Placeholder="Група" />

            <Label Text="{Binding AverageScore, StringFormat='Середній бал: {0:F1}'}" />
            <Slider Value="{Binding AverageScore, Mode=TwoWay}" Minimum="0" Maximum="10" />

            <!-- Відображення (OneWay) -->
            <Label Text="{Binding FullName, StringFormat='Студент: {0}'}" 
                   FontSize="18" FontAttributes="Bold" />
            <Label Text="{Binding Group, StringFormat='Група: {0}'}" />

            <!-- Кнопка -->
            <Button Text="Додати студента" Command="{Binding AddStudentCommand}" />

            <!-- Список студентів -->
            <Label Text="Список студентів:" FontSize="16" FontAttributes="Bold" Margin="0,20,0,0" />
            <CollectionView ItemsSource="{Binding Students}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,5" VerticalOptions="Center">
                            <Label Text="{Binding FullName}" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Text="{Binding Group}" VerticalOptions="Center"/>
                            <Label Text="{Binding AverageScore, StringFormat='(Бал: {0:F1})'}" VerticalOptions="Center"/>

                            <Button Text="Детальніше" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StudentViewModel}}, Path=OpenDetailsCommand}"
                                    CommandParameter="{Binding .}" />

                            <!-- Кнопка видалення з перевіркою ролі в команді (Лаб 6) -->
                            <Button Text="Видалити"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StudentViewModel}}, Path=DeleteStudentCommand}"
                                    CommandParameter="{Binding .}" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>